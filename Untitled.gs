  notify_('All good — Raw data is producing ' + rows + ' rows. See the log for the spend totals.');
}

/**
 * Values-only backup. Deliberately NOT Sheet.copyTo(): that duplicates every bit of
 * formatting and triggers a full recalculation, which on these tabs runs past the
 * 6-minute Apps Script limit. One getValues + one setValues takes a couple of seconds.
 */
function backupValues_(ss, srcName, dstName) {
  var src = ss.getSheetByName(srcName);
  var rows = Math.max(1, src.getLastRow()), cols = Math.max(1, src.getLastColumn());
  var values = src.getRange(1, 1, rows, cols).getValues();
  var old = ss.getSheetByName(dstName);
  if (old) ss.deleteSheet(old);
  var dst = ss.insertSheet(dstName, ss.getSheets().length);
  if (dst.getMaxColumns() < cols) dst.insertColumnsAfter(dst.getMaxColumns(), cols - dst.getMaxColumns());
  if (dst.getMaxRows() < rows) dst.insertRowsAfter(dst.getMaxRows(), rows - dst.getMaxRows());
  dst.getRange(1, 1, rows, cols).setValues(values);
  dst.hideSheet();
  return dst;
}

/**
 * getUi() needs a live spreadsheet UI. Run from the Apps Script editor with the sheet
 * not focused and alert() just hangs until the execution times out — so log first,
 * and only try the dialog as a bonus.
 */
function notify_(msg) {
  Logger.log(msg);
  try { SpreadsheetApp.getUi().alert(msg); } catch (e) { /* no UI attached — the log is enough */ }
}

function requireSheets_(ss, names) {
  var miss = names.filter(function (n) { return !findSheet_(ss, n); });
  if (miss.length) {
    throw new Error('This spreadsheet is missing: ' + miss.join(', ') +
      '.\nRun the script on the Daily Report, and only after the Supermetrics ' +
      'queries have been transferred and refreshed.');
  }
}

/**
 * RAW_FORMULA references e.g. TikTok!$A$2:$DZ. If Supermetrics trimmed the tab to
 * exactly its data width, that reference is out of grid and returns #REF!.
 * Widening is harmless and idempotent — re-run step 3 if a refresh trims them again.
 */
function widenGrids_(ss) {
  Object.keys(MIN_COLUMNS).forEach(function (tab) {
    var sh = findSheet_(ss, tab);
    if (!sh) return;
    var have = sh.getMaxColumns(), need = MIN_COLUMNS[tab];
    if (have >= need) return;
    try {
      sh.insertColumnsAfter(have, need - have);
      Logger.log('widened ' + sh.getName() + ' ' + have + ' -> ' + need);
    } catch (e) {
      throw new Error('Could not widen "' + sh.getName() + '" from ' + have + ' to ' + need +
        ' columns: ' + e.message +
        '\nThe spreadsheet may be at its 10M cell limit — delete an old BACKUP tab and retry.');
    }
  });
}

/**
 * The formula binds Supermetrics columns BY HEADER NAME (XMATCH), so the only thing
 * that breaks it is a header that disappears or gets renamed. X is the exception:
 * its headers repeat (three columns are literally called "Purchases"), so X stays
 * positional and is checked by position.
 */
function checkColumns_(ss) {
  var byName = {
    'Meta':     ['Campaign name','Impressions','Reach','Cost','Clicks (all)','Link clicks',
                 'Mobile app installs','Three-second video views','Mobile app purchases'],
    'TikTok':   ['Campaign name','Impressions','Reach','Cost','Clicks','Clicks (All)',
                 '2-second video views','App installs','Purchase events',
                 'Purchase events (SKAN)','Complete payment events'],
    'Snapchat': ['Campaign name','Impressions','Cost','Swipes','Total app installs',
                 'Purchases','Video views'],
    'Google':   ['Campaign name','Impressions','Cost','Clicks','Video views','Conversions'],
    'Apple':    ['Account name','Campaign name','Impressions','Taps','Cost','Total installs'],
    'GA4':      ['GA4 property','Date','Session campaign name',
                 'Session default channel grouping','Session source / medium',
                 'Transactions','Purchase revenue']
  };
  var byPos = { 'X': {2:'Campaign', 3:'Impressions', 4:'Cost', 6:'Clicks',
                      13:'Video views 3s', 20:'Installs', 23:'Purchases'} };
  var bad = [];
  function header_(tab) {
    var sh = findSheet_(ss, tab), last = sh ? sh.getLastColumn() : 0;
    if (last < 1) { bad.push(tab + ': tab is empty — has "Refresh all queries" run?'); return null; }
    return sh.getRange(1, 1, 1, last).getValues()[0].map(function (v) { return String(v).trim(); });
  }
  Object.keys(byName).forEach(function (tab) {
    var head = header_(tab);
    if (!head) return;
    byName[tab].forEach(function (name) {
      if (head.indexOf(name) === -1) bad.push(tab + ': missing column "' + name + '"');
    });
  });
  Object.keys(byPos).forEach(function (tab) {
    var head = header_(tab);
    if (!head) return;
    Object.keys(byPos[tab]).forEach(function (i) {
      if (head[i - 1] !== byPos[tab][i]) {
        bad.push(tab + ' col ' + i + ': expected "' + byPos[tab][i] + '", found "' + head[i - 1] + '"');
      }
    });
  });
  if (bad.length) {
    throw new Error('Supermetrics columns do not match:\n' + bad.join('\n') +
      '\n\nIf "Complete payment events" is missing, add the complete_payment metric ' +
      'to the TikTok query.');
  }
}

/** Platforms with no Supermetrics connector: InMobi / Bidease / InMotion. */
function rawManual_(ss) {
  if (ss.getSheetByName('Raw manual')) return;      // never wipe existing manual data
  var sh = ss.insertSheet('Raw manual');
  sh.getRange(1, 1, 1, 12).setValues([RAW_HEADERS]).setFontWeight('bold');
  // Take them from whichever copy of the old Raw data still exists — the live tab,
  // or the newest backup if the tab was deleted.
  var src = ss.getSheetByName('Raw data');
  if (!src) {
    var bks = ss.getSheets().filter(function (s) { return s.getName().indexOf('Raw data BACKUP ') === 0; })
                .sort(function (a, b) { return a.getName() < b.getName() ? 1 : -1; });
    src = bks.length ? bks[0] : null;
    if (src) Logger.log('"Raw data" is gone — took the manual platforms from ' + src.getName());
  }
  if (src) {
    var keep = src.getDataRange().getValues().filter(function (r) {
      return ['InMobi', 'Bidease', 'InMotion'].indexOf(String(r[0])) > -1;
    }).map(function (r) { return r.slice(0, 12); });
    if (keep.length) sh.getRange(2, 1, keep.length, 12).setValues(keep);
  }
  sh.setFrozenRows(1);
}

function rawData_(ss) {
  var sh = ss.getSheetByName('Raw data');
  if (!sh) { sh = ss.insertSheet('Raw data'); Logger.log('"Raw data" was missing — recreated it.'); }
  sh.getRange(1, 1, 1, RAW_DATA_HEADERS.length).setValues([RAW_DATA_HEADERS]).setFontWeight('bold');
  var lastRow = sh.getLastRow();
  if (lastRow > 1) sh.getRange(2, 1, lastRow - 1, sh.getMaxColumns()).clearContent();
  sh.getRange('N1').setValue('From').setFontWeight('bold');
  sh.getRange('O1').setValue('Till').setFontWeight('bold');
  sh.getRange('N2').setFormula("='SFQC Pacing_Daily'!$B$2");
  sh.getRange('O2').setFormula("='SFQC Pacing_Daily'!$C$2");
  sh.getRange('N2:O2').setNumberFormat('yyyy-mm-dd');
  sh.getRange('A2').setFormula(resolveTabNames_(ss, rawFormula_()));
  sh.getRange('D2:D').setNumberFormat('yyyy-mm-dd');
  sh.setFrozenRows(1);
}

/** Supermetrics writes GA4 into A:H — wipe the old hand-pasted AAQC block in I onward. */
function ga4Cleanup_(ss) {
  var sh = ss.getSheetByName('GA4');
  var rows = Math.max(1, sh.getLastRow()), cols = sh.getLastColumn();
  if (cols > 8) sh.getRange(1, 9, rows, cols - 8).clearContent();
}

/**
 * Writes every formula in the two Pacing_Daily tabs, not just the GA4 ones.
 * Deleting the "Raw data" tab turns every formula that referenced it into a literal
 * #REF! — recreating a tab with the same name does NOT bring them back. Rewriting the
 * whole set is idempotent and it repairs that damage automatically. An empty string in
 * the spec clears the cell.
 */
function writeFormulas_(ss, spec) {
  Object.keys(spec).forEach(function (tab) {
    var sh = ss.getSheetByName(tab);
    Object.keys(spec[tab]).forEach(function (a1) {
      if (spec[tab][a1] === '') sh.getRange(a1).clearContent();
      else sh.getRange(a1).setFormula(spec[tab][a1]);
    });
  });
}

/** Full undo: restores both tabs, the previous pacing formulas and the GA4 originals. */
function rollback() {
  var ss = SpreadsheetApp.getActive();
  // Only Raw data / GA4 backups count — "Adjust Raw BACKUP ..." tabs have their own stamps.
  var stamps = ss.getSheets().map(function (s) { return s.getName(); })
                 .filter(function (n) { return /^(Raw data|GA4) BACKUP /.test(n); }).sort(function (a, b) {
                   var x = a.split(' BACKUP ')[1], y = b.split(' BACKUP ')[1];
                   return x < y ? -1 : x > y ? 1 : 0;
                 });
  if (!stamps.length) throw new Error('No backup found.');
  var stamp = stamps[stamps.length - 1].split(' BACKUP ')[1];
  ['Raw data', 'GA4'].forEach(function (n) {
    var bk = ss.getSheetByName(n + ' BACKUP ' + stamp);
    if (!bk) return;
    var live = ss.getSheetByName(n);
    if (live) ss.deleteSheet(live);
    bk.setName(n).showSheet();
  });
  writeFormulas_(ss, PACING_ALL);       // the restored Raw data has no Objective column
  writeFormulas_(ss, GA4_ORIGINAL);
  SpreadsheetApp.flush();
  notify_('Restored BACKUP ' + stamp + ' and the original GA4 formulas.');
}

