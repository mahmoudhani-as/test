// ------------------------------------------------------------------ step 1
function step1_backup() {
  var ss = SpreadsheetApp.getActive();
  requireSheets_(ss, REPORT_TABS);
  var stamp = Utilities.formatDate(new Date(), ss.getSpreadsheetTimeZone(), 'yyyyMMdd-HHmm');
  ['Raw data', 'GA4'].forEach(function (n) {
    if (ss.getSheetByName(n)) backupValues_(ss, n, n + ' BACKUP ' + stamp);
    else Logger.log('No "' + n + '" tab to back up — skipped.');
  });
  rawManual_(ss);
  notify_('Backed up as "BACKUP ' + stamp + '" and "Raw manual" is ready.\n\n' +
    'Next: create ONE query from the Supermetrics sidebar, then run step 2.');
}

// ------------------------------------------------------------------ step 1b
/**
 * Writes the 8 Supermetrics query rows into the SupermetricsQueries tab — the same
 * thing as pasting them by hand, minus the chance of pasting them crooked.
 * The account id in column AU is read off the query you made in the sidebar.
 */
function step1b_addQueries(authUser) {
  var ss = SpreadsheetApp.getActive();
  var sh = ss.getSheetByName('SupermetricsQueries');
  if (!sh) {
    throw new Error('No "SupermetricsQueries" tab. Create one query from the Supermetrics ' +
      'sidebar first (Extensions -> Supermetrics -> Manage queries), then run this again.');
  }
  // A hand-made tab with the right NAME is not the same thing: Supermetrics builds rows 1-20
  // (internal ids in H4/H8, the parameter keys in row 20) and only recognises the tab it made
  // itself, on a spreadsheet where the add-on is authorised. Refuse to write into a fake one.
  var keys = sh.getRange(20, 1, 1, 5).getValues()[0].map(function (v) { return String(v).trim(); });
  if (keys[0] !== 'paramsID' || keys[3] !== 'sheetName' || keys[4] !== 'rangeAddress') {
    throw new Error('That "SupermetricsQueries" tab was not created by Supermetrics ' +
      '(row 20 should read paramsID / sheetName / rangeAddress).\n\n' +
      'Creating the tab by hand does not work — Supermetrics has to build it, and the add-on ' +
      'has to be authorised on THIS spreadsheet. Create one query from the sidebar first.');
  }

  var FIRST = 21;                                   // never touch row 20 or above
  var last = sh.getLastRow();
  if (!authUser || String(authUser).trim() === '') {
    if (last >= FIRST) {
      var au = sh.getRange(FIRST, 47, last - FIRST + 1, 1).getValues();
      for (var i = 0; i < au.length; i++) {
        if (String(au[i][0]).trim() !== '') { authUser = String(au[i][0]).trim(); break; }
      }
    }
  }
  if (!authUser || String(authUser).trim() === '') {
    throw new Error('No account found in column AU. Create one query from the Supermetrics ' +
      'sidebar first — any data source, any metric — then run this again.');
  }

  var WIDTH = QUERY_ROWS[0].length;                 // 65 columns, A..BM
  if (sh.getMaxColumns() < WIDTH) sh.insertColumnsAfter(sh.getMaxColumns(), WIDTH - sh.getMaxColumns());

  var existing = {};
  if (last >= FIRST) {
    sh.getRange(FIRST, 4, last - FIRST + 1, 1).getValues().forEach(function (r, i) {
      if (String(r[0]).trim() !== '') existing[String(r[0]).trim()] = FIRST + i;
    });
  }
  var toAdd = QUERY_ROWS.filter(function (r) { return !existing[r[3]]; });
  var skipped = QUERY_ROWS.filter(function (r) { return existing[r[3]]; })
                          .map(function (r) { return r[3]; });
  if (!toAdd.length) {
    notify_('All 8 queries are already in SupermetricsQueries (' + skipped.join(', ') + ').');
    return;
  }
  var rows = toAdd.map(function (r) {
    var c = r.slice();
    c[0] = '';                                      // Supermetrics fills the Query ID on refresh
    c[46] = String(authUser).trim();                // column AU
    return c;
  });
  var start = Math.max(last + 1, FIRST);
  if (sh.getMaxRows() < start + rows.length - 1) {
    sh.insertRowsAfter(sh.getMaxRows(), start + rows.length - 1 - sh.getMaxRows());
  }
  sh.getRange(start, 1, rows.length, WIDTH).setValues(rows);
  SpreadsheetApp.flush();
  notify_('Added ' + rows.length + ' queries at row ' + start + ': ' +
    toAdd.map(function (r) { return r[3]; }).join(', ') +
    (skipped.length ? '\nAlready there: ' + skipped.join(', ') : '') +
    '\n\nNow: Supermetrics sidebar -> Home -> Refresh all queries, then run step 3.');
}

