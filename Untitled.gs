 "[]", "{}", "", "", "", "", "", "", "", "", "GA4'!A1:H905", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", "", ""]];

var RAW_HEADERS = ['A','Campaign','Campaign name','Day','Reach','Impressions',
  'Amount spent (USD)','Link clicks','Clicks (all)','3-second video plays','App installs','Purchases'];
/** Raw data's columns: the twelve Raw manual also uses, plus the pacing line objective. */
var RAW_DATA_HEADERS = RAW_HEADERS.concat(['Objective']);

/**
 * RAW_FORMULA with its objective column filled in from OBJECTIVE_TOKENS (Code.gs). Each
 * row gets exactly one objective — Awareness is tested before Search, everything else is
 * Conversion — so every pacing row can be a plain SUMIFS on column M.
 */
function rawFormula_() {
  return RAW_FORMULA.split('__OBJECTIVE__').join(objectiveFormula_());
}
function objectiveFormula_() {
  function rx(tokens) {
    return tokens.map(function (t) {
      return String(t).toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    }).join('|');
  }
  var tests = [];
  Object.keys(OBJECTIVE_TOKENS).forEach(function (plat) {
    ['Awareness', 'Search'].forEach(function (obj) {
      var tokens = OBJECTIVE_TOKENS[plat][obj];
      if (tokens && tokens.length) {
        tests.push(['(vplat="' + plat + '")*REGEXMATCH(vcamp,"' + rx(tokens) + '")', obj]);
      }
    });
  });
  var f = '"Conversion"';
  for (var i = tests.length - 1; i >= 0; i--) f = 'IF(' + tests[i][0] + ',"' + tests[i][1] + '",' + f + ')';
  return f;
}

/* ------------------------------------------------------------------ pacing formulas */

var PACING_TAB_OF = { SFQC: 'SFQC Pacing_Daily', AAQC: 'AAQC Pacing_Daily' };
// Pacing column -> the Raw data column a media row reads there.
var MEDIA_COLS = { E: 'G', G: 'F', H: 'J', I: 'I', J: 'H', N: 'L', O: 'K' };
// Pacing column -> the Adjust Raw column: K bookings, L installs, X revenue.
var ADJ_COLS = { K: 'I', L: 'H', X: 'E' };

function colRef_(tab, col) { return "'" + tab + "'!$" + col + ':$' + col; }
function dateLit_(iso) {
  var p = iso.split('-').map(Number);
  return 'DATE(' + p[0] + ',' + p[1] + ',' + p[2] + ')';
}
function fromCrit_(floor) {
  return floor ? '">="&MAX($B$2,' + dateLit_(floor) + ')' : '">="&$B$2';
}
function mediaSum_(rawCol, line, brand) {
  function rd(c) { return colRef_('Raw data', c); }
  return 'SUMIFS(' + rd(rawCol) + ',' + rd('A') + ',"' + line.plat + '",' + rd('B') + ',"' + brand +
    '",' + rd('M') + ',"' + line.obj + '",' + rd('D') + ',' + fromCrit_(_mediaFloor(line, brand)) +
    ',' + rd('D') + ',"<="&$C$2)';
}
function adjustSum_(adjCol, app, channel, objective, floor) {
  function aj(c) { return colRef_('Adjust Raw', c); }
  return 'SUMIFS(' + aj(adjCol) + ',' + aj('D') + ',"' + app + '"' +
    (channel ? ',' + aj('J') + ',"' + channel + '"' : '') +
    (objective ? ',' + aj('K') + ',"' + objective + '"' : '') +
    ',' + aj('A') + ',' + fromCrit_(floor) + ',' + aj('A') + ',"<="&$C$2)';
}
function adjustChannels_() {
  return Object.keys(KNOWN_PLATFORMS).map(function (k) { return KNOWN_PLATFORMS[k]; });
}
/** The K / L / X formula for one pacing row — the formula form of _adjustLine() in Code.gs. */
function adjustLineFormula_(adjCol, line, app) {
  var floor = _adjustFloor(line), p = line.plat;
  function s(ch, ob) { return adjustSum_(adjCol, app, ch, ob, floor); }
  if (p === 'Other') {
    // every paid channel that has no row of its own (Other, blank, a new partner)
    return s('<>Organic', '') + adjustChannels_().map(function (ch) { return '-' + s(ch, ''); }).join('');
  }
  if (ADJUST_ONE_LINE[p]) return s(p, '');
  if (line.obj === 'Awareness') return p === 'Google' ? s(p, 'YouTube') + '+' + s(p, 'Awareness') : s(p, 'Awareness');
  if (line.obj === 'Search') return s(p, 'Search');
  // Conversion = everything else the channel recorded, so no objective label is lost
  var others = { Snapchat: ['Awareness'], X: ['Awareness'], TikTok: ['Awareness', 'Search'],
    Google: ['YouTube', 'Awareness', 'Search'] }[p];
  return s(p, '') + others.map(function (ob) { return '-' + s(p, ob); }).join('');
}
// The ratio columns every line row carries (row 7: '=IFERROR(E7/G7*1000,"")' and so on).
var RATIO_COLS = { Q: '=IFERROR(E#/G#*1000,"")', R: '=IFERROR(E#/H#,"")', S: '=IFERROR(E#/I#,"")',
  T: '=IFERROR(I#/G#,"")', U: '=IFERROR(H#/G#,"")', V: '=IFERROR(N#/I#,"")', W: '=IFERROR(O#/I#,"")' };

/** C39: the Raw data spend the media rows are meant to cover, worked out independently. */
function expectedSpend_(brand) {
  function rd(c) { return colRef_('Raw data', c); }
  var win = rd('D') + ',">="&$B$2,' + rd('D') + ',"<="&$C$2';
  var f = 'SUMIFS(' + rd('G') + ',' + rd('B') + ',"' + brand + '",' + rd('A') + ',"<>X",' + rd('A') +
    ',"<>Apple",' + rd('A') + ',"<>InMobi",' + win + ')' +
    '+SUMIFS(' + rd('G') + ',' + rd('B') + ',"' + brand + '",' + rd('A') + ',"X",' + win + ')/' + CFG.FX;
  PACING_LINES.forEach(function (line) {
    var floor = _mediaFloor(line, brand);
    if (line.source || !floor) return;
    // pre-launch days the row deliberately leaves out
    f += '-SUMIFS(' + rd('G') + ',' + rd('A') + ',"' + line.plat + '",' + rd('B') + ',"' + brand + '",' +
      rd('M') + ',"' + line.obj + '",' + win + ',' + rd('D') + ',"<"&MAX($B$2,' + dateLit_(floor) + '))' +
      (line.plat === 'X' ? '/' + CFG.FX : '');
  });
  return '=' + f + '+E22+E24';
}
/** C42: non-organic, non-Other Adjust installs over the same windows the rows use. */
function expectedInstalls_(app) {
  function aj(c) { return colRef_('Adjust Raw', c); }
  var f = 'SUMIFS(' + aj('H') + ',' + aj('D') + ',"' + app + '",' + aj('J') + ',"<>Organic",' + aj('J') +
    ',"<>Other",' + aj('A') + ',' + fromCrit_(CFG.ADJUST_FROM) + ',' + aj('A') + ',"<="&$C$2)';
  PACING_LINES.forEach(function (line) {
    if (line.obj !== 'Awareness') return;
    (line.plat === 'Google' ? ['YouTube', 'Awareness'] : ['Awareness']).forEach(function (ob) {
      // the awareness rows have no floor, so their pre-floor installs count too
      f += '+SUMIFS(' + aj('H') + ',' + aj('D') + ',"' + app + '",' + aj('J') + ',"' + line.plat + '",' +
        aj('K') + ',"' + ob + '",' + aj('A') + ',">="&$B$2,' + aj('A') + ',"<"&MAX($B$2,' +
        dateLit_(CFG.ADJUST_FROM) + '),' + aj('A') + ',"<="&$C$2)';
    });
  });
  return '=' + f;
}

/**
 * The formula set step 3 installs: PACING_ALL with every line, total and check cell that
 * depends on the line rules regenerated from Code.gs. Rows 22 (APPLE1) and 24 (InMobi),
 * the GA4 cells, the SAR column and the ratio columns are PACING_ALL's own.
 */
function buildPacingSpec_() {
  var spec = JSON.parse(JSON.stringify(PACING_ALL));
  ['SFQC', 'AAQC'].forEach(function (brand) {
    var tab = PACING_TAB_OF[brand], t = spec[tab], app = CFG.ADJUST_APP[brand];
    PACING_LINES.forEach(function (line) {
      var r = line.row;
      if (!line.source) {
        Object.keys(MEDIA_COLS).forEach(function (c) {
          var f = '=' + mediaSum_(MEDIA_COLS[c], line, brand);
          t[c + r] = c === 'E' && line.plat === 'X' ? f + '/' + CFG.FX : f;   // X is billed in SAR
        });
        if (line.plat === 'X') t['I' + r] = '=J' + r;                     // X reports no "Clicks (all)"
      }
      Object.keys(ADJ_COLS).forEach(function (c) {
        t[c + r] = '=' + adjustLineFormula_(ADJ_COLS[c], line, app);
      });
      if (CFG.WEB_REVENUE_FROM_GA4 && line.web) t['X' + r] = GA4_NEW[tab]['X' + r];
    });
    t.N26 = ''; t.O26 = '';                 // row 26 has no media; these were InMotion copies
    // media totals: every media row (row 26 has none); the old row 28 had F and J only
    ['E', 'F', 'G', 'H', 'I', 'J', 'N', 'O'].forEach(function (c) { t[c + 28] = '=SUM(' + c + '7:' + c + '10,' + c + '15:' + c + '25)'; });
    Object.keys(RATIO_COLS).forEach(function (c) { t[c + 28] = RATIO_COLS[c].replace(/#/g, '28'); });
    t.K28 = '=SUM(K7:K10,K15:K26)';
    t.L28 = '=SUM(L7:L10,L15:L26)';
    t.M28 = '=SUM(M7:M10,M15:M26)';
    t.X28 = '=SUM(X7:X10,X15:X26)';
    t.P28 = '=IFERROR(X28/F28,"")';
    t.C39 = expectedSpend_(brand);
    t.C42 = expectedInstalls_(app);
    t.C44 = '=' + adjustSum_('H', app, 'Other', '', CFG.ADJUST_FROM);
  });
  return spec;
}

/** RAW_FORMULA reads these ranges, so each tab's grid must be at least this wide. */
var MIN_COLUMNS = { 'Meta': 78, 'TikTok': 130, 'Snapchat': 26, 'Google': 26, 'Apple': 26, 'X': 56 };

var SUPERMETRICS_TABS = ['Meta','TikTok','Snapchat','Google','Apple','X','GA4'];
// 'Raw data' is deliberately not required — this script generates it, so it recreates it if missing.
var REPORT_TABS = ['GA4','Adjust Raw','SFQC Pacing_Daily','AAQC Pacing_Daily'];

