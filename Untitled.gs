/**
 * Qiddiya — rewire "SFQC & AAQC Daily Report" onto Supermetrics.
 *
 * WHERE TO RUN: on the Daily Report spreadsheet itself (the one that holds
 * GA4 / Adjust Raw / SFQC Pacing_Daily / AAQC Pacing_Daily).
 *
 * Reload the spreadsheet after pasting this — a "Qiddiya Setup" menu appears next to Help.
 *
 *   1 · Backup + Raw manual        backs up Raw data + GA4, builds Raw manual
 *   2 · Add the 8 queries          writes them into SupermetricsQueries
 *                                  -> then "Refresh all queries" in the sidebar
 *   3 · Install the formulas       run AFTER the refresh has filled the 8 tabs — and again
 *                                  after any change to the line rules in Code.gs
 *   Check the result               re-runs the checks without changing anything
 *   Undo everything                restores the backups and the original formulas
 *
 * 'Raw data' is NOT leftover: the SUMIFS in the two Pacing_Daily tabs all read from it.
 * It is a single array formula that unions the six platform tabs (plus Raw manual) into
 * twelve columns, plus column M — the pacing line objective (Awareness / Search /
 * Conversion), generated from OBJECTIVE_TOKENS in Code.gs.
 *
 * The pacing formulas are generated by buildPacingSpec_() from the same PACING_LINES,
 * OBJECTIVE_TOKENS and Adjust mapping the dashboard uses (Code.gs). PACING_ALL below is
 * the previous formula set: it is the base for the cells the generator does not touch,
 * and "Revert pacing formulas" puts it back. What the generator changes, and why:
 *   - media rows read column M, so a campaign matching two wildcards (e.g. "Snapchat_AWRN_",
 *     which matched both *snapchat_awr* and *_AWRN_*) is counted once, not twice, and every
 *     X / Google campaign lands on a row (X App and Google App are true remainders);
 *   - Adjust rows count every objective a channel records (Meta, Apple, Bidease, InMobi and
 *     InMotion read all of theirs; the Conversion rows take what the other rows do not) and
 *     row 26 takes every non-organic channel without a row, so no paid install disappears;
 *   - row 28 adds up the same rows in every column (F28/J28 left out awareness while X28
 *     included it; K28 left out row 26 while L28 included it; the AAQC tab summed rows
 *     14-24 instead of 15-25, dropping InMotion);
 *   - N26/O26 (copies of the InMotion row) are cleared; AAQC N19 now uses the same 1 Jul
 *     floor as the rest of its row; every row carries its own tab's B2:C2 window;
 *   - the check cells C39, C42 and C44 apply the same windows and floors as the rows.
 */

var RAW_FORMULA  = "=IFERROR(ARRAYFORMULA(LET(\n  hM, Meta!$A$1:$BZ$1,  hT, TikTok!$A$1:$DZ$1,  hS, Snapchat!$A$1:$Z$1,\n  hG, Google!$A$1:$Z$1, hA, Apple!$A$1:$Z$1,\n  iM_reach, XMATCH(\"Reach\",hM),\n  iM_imp, XMATCH(\"Impressions\",hM),\n  iM_cost, XMATCH(\"Cost\",hM),\n  iM_lc, XMATCH(\"Link clicks\",hM),\n  iM_cl, XMATCH(\"Clicks (all)\",hM),\n  iM_v3, XMATCH(\"Three-second video views\",hM),\n  iM_inst, XMATCH(\"Mobile app installs\",hM),\n  iM_pur, XMATCH(\"Mobile app purchases\",hM),\n  iT_reach, XMATCH(\"Reach\",hT),\n  iT_imp, XMATCH(\"Impressions\",hT),\n  iT_cost, XMATCH(\"Cost\",hT),\n  iT_cl, XMATCH(\"Clicks\",hT),\n  iT_ca, XMATCH(\"Clicks (All)\",hT),\n  iT_v2, XMATCH(\"2-second video views\",hT),\n  iT_inst, XMATCH(\"App installs\",hT),\n  iT_pe, XMATCH(\"Purchase events\",hT),\n  iT_ps, XMATCH(\"Purchase events (SKAN)\",hT),\n  iT_cp, XMATCH(\"Complete payment events\",hT),\n  iS_imp, XMATCH(\"Impressions\",hS),\n  iS_cost, XMATCH(\"Cost\",hS),\n  iS_sw, XMATCH(\"Swipes\",hS),\n  iS_inst, XMATCH(\"Total app installs\",hS),\n  iS_pur, XMATCH(\"Purchases\",hS),\n  iS_vv, XMATCH(\"Video views\",hS),\n  iG_imp, XMATCH(\"Impressions\",hG),\n  iG_cost, XMATCH(\"Cost\",hG),\n  iG_cl, XMATCH(\"Clicks\",hG),\n  iG_vv, XMATCH(\"Video views\",hG),\n  iG_conv, XMATCH(\"Conversions\",hG),\n  iA_acct, XMATCH(\"Account name\",hA),\n  iA_camp, XMATCH(\"Campaign name\",hA),\n  iA_imp, XMATCH(\"Impressions\",hA),\n  iA_taps, XMATCH(\"Taps\",hA),\n  iA_cost, XMATCH(\"Cost\",hA),\n  iA_inst, XMATCH(\"Total installs\",hA),\n  mt, FILTER(Meta!$A$2:$BZ,     Meta!$A$2:$A<>\"\"),\n  tk, FILTER(TikTok!$A$2:$DZ,   TikTok!$A$2:$A<>\"\"),\n  sc, FILTER(Snapchat!$A$2:$Z,  Snapchat!$A$2:$A<>\"\"),\n  gg, FILTER(Google!$A$2:$Z,    Google!$A$2:$A<>\"\"),\n  ap, FILTER(Apple!$A$2:$Z,     Apple!$A$2:$A<>\"\"),\n  xx, FILTER(X!$A$2:$BD,        X!$A$2:$A<>\"\"),\n  mn, IFERROR(FILTER('Raw manual'!$A$2:$L,'Raw manual'!$A$2:$A<>\"\"),HSTACK(\"\",\"\",\"\",0,0,0,0,0,0,0,0,0)),\n  dat, VSTACK(\n    HSTACK(\n      IF(CHOOSECOLS(mt,2)=\"\",\"Meta\",\"Meta\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(mt,2)),\"SFQC|SIX[ _-]?FLAGS\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(mt,2)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(mt,2),\n      CHOOSECOLS(mt,1),\n      IF(CHOOSECOLS(mt,iM_reach)=\"\",0,CHOOSECOLS(mt,iM_reach)),\n      IF(CHOOSECOLS(mt,iM_imp)=\"\",0,CHOOSECOLS(mt,iM_imp)),\n      IF(CHOOSECOLS(mt,iM_cost)=\"\",0,CHOOSECOLS(mt,iM_cost)),\n      IF(CHOOSECOLS(mt,iM_lc)=\"\",0,CHOOSECOLS(mt,iM_lc)),\n      IF(CHOOSECOLS(mt,iM_cl)=\"\",0,CHOOSECOLS(mt,iM_cl)),\n      IF(CHOOSECOLS(mt,iM_v3)=\"\",0,CHOOSECOLS(mt,iM_v3)),\n      IF(CHOOSECOLS(mt,iM_inst)=\"\",0,CHOOSECOLS(mt,iM_inst)),\n      IF(CHOOSECOLS(mt,iM_pur)=\"\",0,CHOOSECOLS(mt,iM_pur))\n    ),\n    HSTACK(\n      IF(CHOOSECOLS(tk,2)=\"\",\"TikTok\",\"TikTok\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(tk,2)),\"SFQC|SIX[ _-]?FLAGS\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(tk,2)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(tk,2),\n      CHOOSECOLS(tk,1),\n      IF(CHOOSECOLS(tk,iT_reach)=\"\",0,CHOOSECOLS(tk,iT_reach)),\n      IF(CHOOSECOLS(tk,iT_imp)=\"\",0,CHOOSECOLS(tk,iT_imp)),\n      IF(CHOOSECOLS(tk,iT_cost)=\"\",0,CHOOSECOLS(tk,iT_cost)),\n      IF(CHOOSECOLS(tk,iT_cl)=\"\",0,CHOOSECOLS(tk,iT_cl)),\n      IF(CHOOSECOLS(tk,iT_ca)=\"\",0,CHOOSECOLS(tk,iT_ca)),\n      IF(CHOOSECOLS(tk,iT_v2)=\"\",0,CHOOSECOLS(tk,iT_v2)),\n      IF(CHOOSECOLS(tk,iT_inst)=\"\",0,CHOOSECOLS(tk,iT_inst)),\n      IF(CHOOSECOLS(tk,iT_pe)=\"\",0,CHOOSECOLS(tk,iT_pe))+IF(CHOOSECOLS(tk,iT_ps)=\"\",0,CHOOSECOLS(tk,iT_ps))+IF(CHOOSECOLS(tk,iT_cp)=\"\",0,CHOOSECOLS(tk,iT_cp))\n    ),\n    HSTACK(\n      IF(CHOOSECOLS(sc,2)=\"\",\"Snapchat\",\"Snapchat\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(sc,2)),\"SFQC|SIX[ _-]?FLAGS|FIRST STORY\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(sc,2)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(sc,2),\n      CHOOSECOLS(sc,1),\n      IF(CHOOSECOLS(sc,2)=\"\",0,0),\n      IF(CHOOSECOLS(sc,iS_imp)=\"\",0,CHOOSECOLS(sc,iS_imp)),\n      IF(CHOOSECOLS(sc,iS_cost)=\"\",0,CHOOSECOLS(sc,iS_cost)),\n      IF(CHOOSECOLS(sc,2)=\"\",0,0),\n      IF(CHOOSECOLS(sc,iS_sw)=\"\",0,CHOOSECOLS(sc,iS_sw)),\n      IF(CHOOSECOLS(sc,iS_vv)=\"\",0,CHOOSECOLS(sc,iS_vv)),\n      IF(CHOOSECOLS(sc,iS_inst)=\"\",0,CHOOSECOLS(sc,iS_inst)),\n      IF(CHOOSECOLS(sc,iS_pur)=\"\",0,CHOOSECOLS(sc,iS_pur))\n    ),\n    HSTACK(\n      IF(CHOOSECOLS(gg,2)=\"\",\"Google\",\"Google\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(gg,2)),\"SFQC|SIX[ _-]?FLAGS\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(gg,2)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(gg,2),\n      CHOOSECOLS(gg,1),\n      IF(CHOOSECOLS(gg,2)=\"\",0,0),\n      IF(CHOOSECOLS(gg,iG_imp)=\"\",0,CHOOSECOLS(gg,iG_imp)),\n      IF(CHOOSECOLS(gg,iG_cost)=\"\",0,CHOOSECOLS(gg,iG_cost)),\n      IF(CHOOSECOLS(gg,2)=\"\",0,0),\n      IF(CHOOSECOLS(gg,iG_cl)=\"\",0,CHOOSECOLS(gg,iG_cl)),\n      IF(CHOOSECOLS(gg,iG_vv)=\"\",0,CHOOSECOLS(gg,iG_vv)),\n      IF((ISNUMBER(SEARCH(\"uac\",CHOOSECOLS(gg,2)))+ISNUMBER(SEARCH(\"app installs\",CHOOSECOLS(gg,2))))>0,IF(CHOOSECOLS(gg,iG_conv)=\"\",0,CHOOSECOLS(gg,iG_conv)),0),\n      IF(CHOOSECOLS(gg,iG_conv)=\"\",0,CHOOSECOLS(gg,iG_conv))\n    ),\n    HSTACK(\n      IF(CHOOSECOLS(ap,iA_camp)=\"\",\"Apple\",\"Apple\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(ap,iA_acct)),\"SFQC|SIX[ _-]?FLAGS\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(ap,iA_acct)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(ap,iA_camp),\n      CHOOSECOLS(ap,1),\n      IF(CHOOSECOLS(ap,iA_camp)=\"\",0,0),\n      IF(CHOOSECOLS(ap,iA_imp)=\"\",0,CHOOSECOLS(ap,iA_imp)),\n      IF(CHOOSECOLS(ap,iA_cost)=\"\",0,CHOOSECOLS(ap,iA_cost)),\n      IF(CHOOSECOLS(ap,iA_camp)=\"\",0,0),\n      IF(CHOOSECOLS(ap,iA_taps)=\"\",0,CHOOSECOLS(ap,iA_taps)),\n      IF(CHOOSECOLS(ap,iA_camp)=\"\",0,0),\n      IF(CHOOSECOLS(ap,iA_inst)=\"\",0,CHOOSECOLS(ap,iA_inst)),\n      IF(CHOOSECOLS(ap,iA_camp)=\"\",0,0)\n    ),\n    HSTACK(\n      IF(CHOOSECOLS(xx,2)=\"\",\"X\",\"X\"),\n      IF(REGEXMATCH(UPPER(CHOOSECOLS(xx,2)),\"SFQC|SIX[ _-]?FLAGS\"),\"SFQC\",IF(REGEXMATCH(UPPER(CHOOSECOLS(xx,2)),\"AAQC|AQQC|AQC[-_]|AQUARABIA\"),\"AAQC\",\"UNMAPPED\")),\n      CHOOSECOLS(xx,2),\n      CHOOSECOLS(xx,1),\n      IF(CHOOSECOLS(xx,2)=\"\",0,0),\n      IF(CHOOSECOLS(xx,3)=\"\",0,CHOOSECOLS(xx,3)),\n      IF(CHOOSECOLS(xx,4)=\"\",0,CHOOSECOLS(xx,4)),\n      IF(CHOOSECOLS(xx,6)=\"\",0,CHOOSECOLS(xx,6)),\n      IF(CHOOSECOLS(xx,2)=\"\",0,0),\n      IF(CHOOSECOLS(xx,13)=\"\",0,CHOOSECOLS(xx,13)),\n      IF(CHOOSECOLS(xx,20)=\"\",0,CHOOSECOLS(xx,20)),\n      IF(CHOOSECOLS(xx,23)=\"\",0,CHOOSECOLS(xx,23))\n    ),\n    mn\n  ),\n  vplat, CHOOSECOLS(dat,1),\n  vcamp, LOWER(CHOOSECOLS(dat,3)),\n  vobj, IFERROR(__OBJECTIVE__,\"Conversion\"),\n  vout, HSTACK(dat, vobj),\n  FILTER(vout,IFERROR((CHOOSECOLS(vout,4)>=$N$2)*(CHOOSECOLS(vout,4)<=$O$2),0))\n)),\"\")";
var GA4_NEW      = {
 "SFQC Pacing_Daily": {
