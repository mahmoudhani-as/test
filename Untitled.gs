// ------------------------------------------------------------------ one-run repair
/**
 * Repairs this workbook in place, in one run (Qiddiya Setup → Fix this workbook). It
 * applies what the audit of the live file found, and leaves Raw data the pasted table it
 * is today — it does NOT switch Raw data to the Supermetrics formula (that is step 3).
 *   1. hidden backups of the tabs it changes
 *   2. Raw data: the Objective column (M) every media row now filters on
 *   3. Raw manual: numbers stored as text ("15,62,702") become numbers
 *   4. Adjust Raw: text and day/month-swapped dates, overlapping imports, Twitter rows
 *   5. one date window: AAQC follows SFQC B2:C2, and "till" is yesterday
 *   6. the unified pacing formulas, totals and checks
 * Running it again is harmless.
 */
function fixThisWorkbook() {
  var ss = SpreadsheetApp.getActive();
  requireSheets_(ss, ['Raw data', 'Raw manual', 'Adjust Raw', PACING_TAB_OF.SFQC, PACING_TAB_OF.AAQC]);
  var stamp = _stamp();                      // same stamp format as the Adjust Raw backup
  var report = [];
  [PACING_TAB_OF.SFQC, PACING_TAB_OF.AAQC].forEach(function (n) {
    var name = n + ' BACKUP ' + stamp, old = ss.getSheetByName(name);
    if (old) ss.deleteSheet(old);
    ss.getSheetByName(n).copyTo(ss).setName(name).hideSheet();       // small tabs: keep the formulas
  });
  backupValues_(ss, 'Raw manual', 'Raw manual BACKUP ' + stamp);
  report.push('Backups (hidden): the two pacing tabs and Raw manual, "… BACKUP ' + stamp + '".');
  report.push(objectiveColumn_(ss));
  report.push(rawManualNumbers_(ss));
  report.push(cleanAdjustRaw_());                                      // backs up and logs itself
  report.push(alignWindows_(ss));
  writeFormulas_(ss, buildPacingSpec_());
  SpreadsheetApp.flush();
  report.push('Pacing formulas, totals and checks rewritten in both tabs.');
  report.push('Next: Pacing dashboard → Validate against the pacing tabs.');
  notify_(report.join('\n\n'));
}

/** Raw data column M for a pasted Raw data (the Supermetrics formula fills M itself). */
function objectiveColumn_(ss) {
  var sh = ss.getSheetByName('Raw data');
  if (sh.getRange('A2').getFormula()) return 'Raw data: the Supermetrics formula already fills column M.';
  if (sh.getMaxColumns() < 13) sh.insertColumnsAfter(sh.getMaxColumns(), 13 - sh.getMaxColumns());
  sh.getRange('M2:M').clearContent();
  sh.getRange('M1').setValue('Objective').setFontWeight('bold');
  sh.getRange('M2').setFormula(objectiveColumnFormula_());
  return 'Raw data: Objective column added (M1:M). Keep it when you paste new data into A:L.';
}
function objectiveColumnFormula_() {
  return '=ARRAYFORMULA(IF(A2:A="","",LET(vplat,A2:A,vcamp,LOWER(C2:C),' + objectiveFormula_() + ')))';
}

/** SUMIFS skips numbers stored as text; Raw manual's InMobi impressions came that way. */
function rawManualNumbers_(ss) {
  var sh = ss.getSheetByName('Raw manual'), last = sh.getLastRow();
  if (last < 2) return 'Raw manual: no rows.';
  var rng = sh.getRange(2, 5, last - 1, 8), v = rng.getValues(), n = 0;   // E:L
  v.forEach(function (row) {
    row.forEach(function (x, j) {
      if (typeof x !== 'string' || !x.trim()) return;
      var s = x.replace(/[,\s]/g, '').replace(/^(-?)\$/, '$1');
      if (/^-?(?:\d+\.?\d*|\.\d+)$/.test(s)) { row[j] = +s; n++; }
    });
  });
  if (n) rng.setValues(v);
  return 'Raw manual: ' + n + ' numbers stored as text converted to numbers.';
}

/**
 * The dashboard reads one window (SFQC B2:C2); the AAQC tab had its own (21 Jun - yesterday
 * against 22 Jun - 1 Sep). Both tabs now follow SFQC, whose "till" becomes yesterday — type a
 * date into SFQC C2 to report a fixed period.
 */
function alignWindows_(ss) {
  var sf = ss.getSheetByName(PACING_TAB_OF.SFQC), aa = ss.getSheetByName(PACING_TAB_OF.AAQC);
  var link = "='" + PACING_TAB_OF.SFQC + "'!C2";
  // first run only: a later run keeps whatever period you have typed into SFQC C2
  if (aa.getRange('C2').getFormula() !== link) sf.getRange('C2').setFormula('=TODAY()-1');
  aa.getRange('B2').setFormula("='" + PACING_TAB_OF.SFQC + "'!B2");
  aa.getRange('C2').setFormula(link);
  aa.getRange('B2:C2').setNumberFormat(sf.getRange('B2').getNumberFormat() || 'yyyy-mm-dd');
  return 'Date window: both tabs follow SFQC B2:C2 (' + sf.getRange('B2').getDisplayValue() + ' to ' +
    sf.getRange('C2').getDisplayValue() + ').';
}

// ------------------------------------------------------------------ helpers
/**
 * Case-tolerant sheet lookup. Supermetrics named the Meta tab "META" in this file,
 * so every Supermetrics-tab lookup goes through here.
 */
function findSheet_(ss, name) {
  var exact = ss.getSheetByName(name);
  if (exact) return exact;
  var all = ss.getSheets();
  for (var i = 0; i < all.length; i++) {
    if (all[i].getName().toLowerCase() === String(name).toLowerCase()) return all[i];
  }
  return null;
}

/**
 * Supermetrics names the tab after the data source and the case is not guaranteed —
 * this file came back with "META" while the formula says "Meta". Rewrite the formula
 * with whatever the tabs are actually called before writing it.
 */
function resolveTabNames_(ss, formula) {
  var names = ss.getSheets().map(function (s) { return s.getName(); });
  ['Meta', 'TikTok', 'Snapchat', 'Google', 'Apple', 'X'].forEach(function (want) {
    var actual = null;
    for (var i = 0; i < names.length; i++) {
      if (names[i] === want) { actual = names[i]; break; }
      if (names[i].toLowerCase() === want.toLowerCase()) actual = names[i];
    }
    if (!actual) throw new Error('No tab found for "' + want + '".');
    if (actual !== want) {
      var ref = /[^A-Za-z0-9_]/.test(actual) ? "'" + actual + "'!" : actual + '!';
      formula = formula.split(want + '!').join(ref);
      Logger.log('tab "' + want + '" is actually "' + actual + '" — formula updated');
    }
  });
  return formula;
}

/**
 * Safety net for spend no pacing row can pick up. Through column M every row lands on
 * exactly one line, so only two things can still slip through: a campaign whose name
 * carries no portal token (column B = UNMAPPED), and a platform name with no pacing row
 * (usually a typo in Raw manual).
 */
function coverageCheck_(ss) {
  var rd = ss.getSheetByName('Raw data');
  var last = rd.getLastRow();
  if (last < 2) return [];
  var v = rd.getRange(2, 1, last - 1, 13).getValues();
  var missed = {};
  v.forEach(function (r) {
    if (r[0] === '' || r[0] === null) return;
    var spend = Number(r[6]) || 0;
    if (spend <= 0) return;
    var hasPortal = !!_brandCell(r[1]), plat = _canonPlat(r[0]);
    var hasRow = !!(plat && LINE_BY_KEY[plat + '|' + r[12]]);
    if (hasPortal && hasRow) return;
    var key = (hasPortal ? '' : 'no portal: ') + (hasRow ? '' : 'no pacing row: ') +
      r[0] + ' / ' + r[1] + ' / ' + r[2];
    missed[key] = (missed[key] || 0) + spend;
  });
  return Object.keys(missed).map(function (k) {
    return k + '  —  ' + Math.round(missed[k]) + ' (platform currency)';
  });
}

/** Reads back what was written. A silent no-op here is exactly the failure we hit before. */
function verifyInstall_(ss) {
  // Sheets normalises GA4! to 'GA4'! when it stores a formula, so compare unquoted.
  function bare(f) { return String(f).split("'").join(''); }
  var problems = [];
  var rd = ss.getSheetByName('Raw data');
  var a2 = rd.getRange('A2').getFormula();
  if (!a2) problems.push('Raw data!A2 is empty — the array formula did not stick.');
  else if (a2.indexOf('ARRAYFORMULA(LET(') === -1) problems.push('Raw data!A2 holds something unexpected: ' + a2.slice(0, 60));
  if (!rd.getRange('N2').getFormula()) problems.push('Raw data!N2 is empty.');
  if (String(rd.getRange('M1').getValue()).trim() !== 'Objective') {
    problems.push('Raw data!M1 is not "Objective" — the line objective column is missing.');
  } else if (rd.getLastRow() > 1 &&
             ['Awareness', 'Search', 'Conversion'].indexOf(String(rd.getRange('M2').getValue())) < 0) {
    problems.push('Raw data!M2 holds "' + rd.getRange('M2').getValue() + '" instead of an objective.');
  }

  var rows = rd.getLastRow();
  Logger.log('Raw data spills ' + rows + ' rows.');
  if (rows < 100) problems.push('Raw data only has ' + rows + ' rows — check A2 for an error value.');

  ['SFQC Pacing_Daily', 'AAQC Pacing_Daily'].forEach(function (tab) {
    var sh = ss.getSheetByName(tab);
    if (bare(sh.getRange('M7').getFormula()).indexOf('GA4!') === -1) {
      problems.push(tab + '!M7 was not rewritten.');
    }
    // The point of the whole exercise: these must come out as numbers, not zeros or errors.
    var spend = sh.getRange('E7:E10').getValues().concat(sh.getRange('E15:E25').getValues());
    var total = 0, errs = 0;
    spend.forEach(function (r) {
      if (typeof r[0] === 'number') total += r[0];
      else if (String(r[0]).indexOf('#') === 0) errs++;
    });
    Logger.log(tab + ': spend = ' + Math.round(total) + ' USD, ' + errs + ' error cells');
    if (errs) problems.push(tab + ' has ' + errs + ' error cells in the spend column.');
    if (total <= 0) problems.push(tab + ' spend came out ' + total + ' — Raw data is not feeding it.');
  });

  var missed = coverageCheck_(ss);
  if (missed.length) {
    Logger.log('SPEND NOT PICKED UP BY ANY ROW:\n' + missed.join('\n'));
    problems.push('Spend that no pacing row can count (see the log): ' + missed.length + ' campaign(s).');
  } else {
    Logger.log('Coverage: every Raw data dollar has a portal and a pacing row.');
  }

  if (problems.length) {
    throw new Error('Installed, but the result is wrong:\n' + problems.join('\n') +
      '\n\nIf the spend cells show #REF!, a tab they referenced was deleted at some point — ' +
      'run "Repair Pacing_Daily formulas" from the Qiddiya Setup menu.');
  }
  return rows;
}

/**
 * Builds a "Validation" tab made of live formulas — it re-computes itself on every
 * Supermetrics refresh, so it always shows the current state rather than a snapshot.
 * Run it once; after that just open the tab.
 *
 * Column E is the verdict. Anything red means look at that line.
 */
function buildValidationTab() {
  var ss = SpreadsheetApp.getActive();
  // Supermetrics may name a tab META rather than Meta — quote whatever it actually is.
  function ref(want) {
    var sh = findSheet_(ss, want);
    if (!sh) throw new Error('No tab found for "' + want + '".');
    var n = sh.getName();
    return /[^A-Za-z0-9_]/.test(n) ? "'" + n + "'" : n;
  }
  var P = {}; ['Meta','TikTok','Snapchat','Google','Apple','X'].forEach(function (t) { P[t] = ref(t); });
  var RD = "'Raw data'";
  var F = '$B$2', T = '$D$2';                       // the window, echoed at the top of this tab

  // Cost column is looked up by header name, so adding or moving metrics cannot break it.
  function cost(t) { return 'INDEX(' + P[t] + '!$A:$DZ,0,MATCH("Cost",' + P[t] + '!$1:$1,0))'; }
  function tabSpend(t) {
    return '=ROUND(SUMIFS(' + cost(t) + ',' + P[t] + '!$A:$A,">="&' + F + ',' + P[t] + '!$A:$A,"<="&' + T + '),0)';
  }
  function rawSpend(t) { return '=ROUND(SUMIFS(' + RD + '!$G:$G,' + RD + '!$A:$A,"' + t + '"),0)'; }

  var rows = [];
  function r(a,b,c,d,e) { rows.push([a,b,c,d,e]); }
  function sec(t) { r('','','','',''); r(t,'','','',''); }
  var OKF = function (cond) { return '=IF(' + cond + ',"OK","CHECK")'; };

  r('QIDDIYA — VALIDATION (live)','','','','');
  r('Window', "='SFQC Pacing_Daily'!B2", 'to', "='SFQC Pacing_Daily'!C2", '');
  r('Recalculated', '=TEXT(NOW(),"yyyy-mm-dd hh:mm")', '', '', '');

  sec('A · DATA FRESHNESS');
  r('Tab','Rows','Last date','Days behind','Status');
  var first = rows.length + 1;
  ['Meta','TikTok','Snapchat','Google','Apple','X'].forEach(function (t) {
    var n = rows.length + 1;
    r(P[t].split("'").join(''),
      '=COUNTA(' + P[t] + '!$A$2:$A)',
      '=IFERROR(TEXT(MAX(' + P[t] + '!$A$2:$A),"yyyy-mm-dd"),"—")',
      '=IFERROR(TODAY()-MAX(' + P[t] + '!$A$2:$A),999)',
      OKF('D' + n + '<=2'));
  });
  var n1 = rows.length + 1;
  r("Adjust Raw  (manual)", "=COUNTA('Adjust Raw'!$A$2:$A)",
    '=IFERROR(TEXT(MAX(\'Adjust Raw\'!$A$2:$A),"yyyy-mm-dd"),"—")',
    '=IFERROR(TODAY()-MAX(\'Adjust Raw\'!$A$2:$A),999)', OKF('D' + n1 + '<=2'));
  var n2 = rows.length + 1;
  r("Raw manual  (manual)", "=COUNTA('Raw manual'!$A$2:$A)",
    '=IFERROR(TEXT(MAX(\'Raw manual\'!$D$2:$D),"yyyy-mm-dd"),"—")',
    '=IFERROR(TODAY()-MAX(\'Raw manual\'!$D$2:$D),999)', OKF('D' + n2 + '<=2'));

  sec('B · SPEND RECONCILIATION — platform tab vs Raw data (window only)');
  r('Platform','Platform tab','Raw data','Diff','Status');
  ['Meta','TikTok','Snapchat','Google','Apple','X'].forEach(function (t) {
    var n = rows.length + 1;
    r(t, tabSpend(t), rawSpend(t), '=C' + n + '-B' + n, OKF('ABS(D' + n + ')<=1'));
  });
  ['InMobi','Bidease','InMotion'].forEach(function (t) {
    r(t + '  (manual)', '', rawSpend(t), '', 'OK');
  });

  sec('C · PACING TOTALS — rows E7:E25 vs the spend they should cover (USD)');
  r('Brand','Pacing rows (C40)','Expected (C39)','Diff','Status');
  [['SFQC','SFQC Pacing_Daily'],['AAQC','AAQC Pacing_Daily']].forEach(function (p) {
    var n = rows.length + 1, s = "'" + p[1] + "'";
    // C39 re-derives the spend from Raw data, APPLE1 and the InMobi sources with the same
    // floors the rows use, so a difference means spend that landed on no row.
    r(p[0], '=ROUND(' + s + '!C40,0)', '=ROUND(' + s + '!C39,0)',
      '=B' + n + '-C' + n, OKF('ABS(D' + n + ')<=2'));
  });

  sec('D · COVERAGE — spend no pacing row can count');
  r('Check','Value','','','Status');
  var d1 = rows.length + 1;
  r('Raw data spend with no portal (column B not SFQC/AAQC)',
    '=ROUND(SUMIFS(' + RD + '!$G$2:$G,' + RD + '!$A$2:$A,"<>",' + RD + '!$B$2:$B,"<>SFQC",' +
      RD + '!$B$2:$B,"<>AAQC"),2)', '', '', OKF('B' + d1 + '<0.01'));
  var d2 = rows.length + 1;
  r('Raw data line objective column (M1)', '=' + RD + '!$M$1', '', '', OKF('B' + d2 + '="Objective"'));
  var d3 = rows.length + 1;
  r('Adjust Raw rows with a text date (SUMIFS skips them)',
    "=SUMPRODUCT(--ISTEXT('Adjust Raw'!$A$2:$A))", '', '', OKF('B' + d3 + '=0'));

  sec('E · FORMULA HEALTH');
  r('Check','Value','','','Status');
  var e1 = rows.length + 1;
  r('Raw data rows', '=COUNTA(' + RD + '!$A$2:$A)', '', '', OKF('B' + e1 + '>100'));
  var e2 = rows.length + 1;
  r('Error cells in the spend columns',
    "=SUMPRODUCT(--ISERROR('SFQC Pacing_Daily'!$E$7:$E$25))+SUMPRODUCT(--ISERROR('AAQC Pacing_Daily'!$E$7:$E$25))",
    '', '', OKF('B' + e2 + '=0'));
  var e3 = rows.length + 1;
  r('Window end vs yesterday', "='SFQC Pacing_Daily'!C2", '=TODAY()-1-B' + e3 + '', 'days behind',
    OKF('C' + e3 + '<=1'));
  var e4 = rows.length + 1;
  // Count only the rows ABOVE this one — E:E would include this cell and go circular.
  r('OVERALL', '=COUNTIF(E1:E' + (e4 - 1) + ',"CHECK")', 'line(s) need a look', '', OKF('B' + e4 + '=0'));

  var sh = ss.getSheetByName('Validation');
  if (!sh) sh = ss.insertSheet('Validation');
  sh.clear();
  sh.getRange(1, 1, rows.length, 5).setValues(rows);
  sh.getRange('A1').setFontSize(14).setFontWeight('bold');
  sh.getRange('B2').setNumberFormat('yyyy-mm-dd');
  sh.getRange('D2').setNumberFormat('yyyy-mm-dd');
  sh.getRange('B' + e3).setNumberFormat('yyyy-mm-dd');
  rows.forEach(function (rw, i) {
    if (String(rw[0]).indexOf(' · ') > -1) {
      sh.getRange(i + 1, 1, 1, 5).setFontWeight('bold').setBackground('#000050').setFontColor('#ffffff');
    }
  });
  sh.getRange(1, 5, rows.length, 1).setHorizontalAlignment('center');
  var rules = [
    SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('OK')
      .setBackground('#d9ead3').setRanges([sh.getRange(1, 5, rows.length, 1)]).build(),
    SpreadsheetApp.newConditionalFormatRule().whenTextEqualTo('CHECK')
      .setBackground('#f4cccc').setRanges([sh.getRange(1, 5, rows.length, 1)]).build()
  ];
  sh.setConditionalFormatRules(rules);
  sh.setColumnWidth(1, 330); sh.setColumnWidth(2, 140); sh.setColumnWidth(3, 150);
  sh.setColumnWidth(4, 120); sh.setColumnWidth(5, 80);
  sh.setFrozenRows(3);
  ss.setActiveSheet(sh);
  SpreadsheetApp.flush();
  notify_('"Validation" tab built. It is all formulas, so it re-checks itself on every refresh — ' +
          'just open it whenever you want to be sure.');
}

/** Rewrites every formula per Pacing_Daily tab — use if a tab got deleted and broke them. */
function repairPacingFormulas() {
  var ss = SpreadsheetApp.getActive();
  var spec = buildPacingSpec_();
  writeFormulas_(ss, spec);
  SpreadsheetApp.flush();
  notify_('Rewrote ' + Object.keys(spec[PACING_TAB_OF.SFQC]).length + ' cells in each Pacing_Daily tab.');
